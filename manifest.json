{
  "manifest_version": 3,
  "name": "Shopee Malaysia Detector",
  "version": "1.0.1",
  "description": "Detects and extracts product info from Shopee Malaysia.",
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://shopee.com.my/*",
    "https://*.img.susercontent.com/*"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "icons": {
    "16": "Kopi.png",
    "48": "Kopi.png",
    "128": "Kopi.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://shopee.com.my/*"
      ],
      "js": [
        "content.js"
      ]
    }
  ]
}